# ASCII Mandelbrot and Julia set renderer, in fixed-point arithmetic via the
# scale factor k: numbers are num/10^k. Each render is a WxH grid; a char ramp
# maps the iteration count to bytes. Runs identically under rpn and dc.
# Notes: rpn string literals must close on one line (each macro is one line),
# register names are written compactly (dc reads the name as the very next
# character), value registers are lowercase and macro registers uppercase
# (register names are case-sensitive).

# --- knobs: change these ---
8 k          # scale: k decimal digits per number (k=6 -> 6 digits)
32 sm        # M: max iterations per pixel

# --- engine: no need to change below ---
# char ramp for iteration bands 0..10 (10 = never escaped = inside the set)
32 0 :R 46 1 :R 58 2 :R 45 3 :R 61 4 :R 43 5 :R 42 6 :R 35 7 :R 37 8 :R 64 9 :R 88 10 :R
# iteration loop: z = z^2 + c while i < m and |z|^2 <= 4; c comes from macros
# G/H (the pixel itself for Mandelbrot, a fixed constant for Julia)
[lu lu * lv lv * - lGx + st lv lu * 2 * lHx + sv lt su 1 li + si lm li <J] sI
[4 lu lu * lv lv * + !>I] sJ
# one pixel: p,q = pixel coords, init z per mode g, iterate, print ramp[i*10/m]
[la lx le * + sp lc ly lf * + sq lg 0 =M lg 1 =N 0 si lIx K sz 0 k li 10 * lm / ;R P lz k] sK
[0 su 0 sv] sM
[lp su lq sv] sN
[lK x 1 lx + sx lw lx !>X] sX
[1 sx lX x 10 P 1 ly + sy lh ly !>Y] sY

# ===== Mandelbrot render: c = the pixel, window x in [a,b], y in [c,d] =====
_2 sa 1 sb _1.2 sc 1.2 sd    # window: x0, x1, y0, y1
70 sw 20 sh                    # W x H: grid size of render
lb la - lw / se                # stepx and stepy, derived from the window
ld lc - lh / sf
[lp] sG    # c = pixel (Mandelbrot mode)
[lq] sH
0 sg
1 sy lYx
10 P

# ===== Julia render: z = the pixel, c = n + o*i, a fixed constant =====
# Window cropped to the set's extent at the same zoom as Mandelbrot (stepx
# 0.075, stepy 0.15): x in [-1.5, 1.5] over 50 cols, y in [-1.05, 1.05] over
# 18 rows, so the fractal keeps its size and the blank rows disappear.
_1.5 sa 1.5 sb _1 sc 1.05 sd
70 sw 18 sh                     # W x H: grid size of render
lb la - lw / se
ld lc - lh / sf
_0.8 sn                         # Julia constant c = n + o*i
0.156 so
[ln] sG    # c = the constant (Julia mode)
[lo] sH
1 sg
1 sy lYx
10 P
q
